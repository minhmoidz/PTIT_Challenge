# PICC 2026 Production Environment Configuration Template

# Server & Network
PORT=3001
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL Production Connection String)
DATABASE_URL=postgresql://picc_user:secure_password_here@localhost:5432/picc2026_db?schema=public

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_must_be_at_least_32_chars
ACCESS_TOKEN_TTL=1d
REFRESH_TOKEN_TTL=7d

# Competition Rules & Windows
PICC_REGISTRATION_OPEN_AT=2026-08-01T00:00:00+07:00
PICC_REGISTRATION_CLOSE_AT=2026-08-15T23:59:59+07:00
PICC_REGISTRATION_ENABLED=true

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=picc2026-assets
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email SMTP Provider
SMTP_HOST=smtp.ptit.edu.vn
SMTP_PORT=587
SMTP_USER=iec@ptit.edu.vn
SMTP_PASSWORD=
MAIL_FROM="Ban Tổ Chức PICC 2026 <iec@ptit.edu.vn>"
