FROM node:22-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@11
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Generate the client here, in the stage that definitely has the prisma CLI and
# schema, so the compiled client (incl. the query engine) is baked into the
# node_modules we copy below. The old `npx prisma generate || true` in the runner
# silently did nothing (npx tried to fetch the CLI from the registry and the
# `|| true` swallowed the failure), so the container crashed with
# "@prisma/client did not initialize yet".
RUN pnpm exec prisma generate

FROM node:22-alpine AS runner
WORKDIR /app
# Prisma's query engine requires OpenSSL on Alpine.
RUN apk add --no-cache openssl
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/server ./server
COPY --from=builder /app/api ./api
COPY --from=builder /app/src ./src
COPY --from=builder /app/prisma ./prisma

COPY --from=builder /app/tsconfig.json ./tsconfig.json
COPY --from=builder /app/tsconfig.node.json ./tsconfig.node.json
COPY --from=builder /app/scripts/db-push.sh ./scripts/db-push.sh
# Run as non-root. Registrations live in Postgres, so no writable data dir is
# needed inside the container.
RUN chown -R node:node /app
USER node
EXPOSE 3001
ENV NODE_ENV=production
# Apply schema changes before serving so a stale DB can never take
# registrations down silently. `db push` refuses destructive changes unless
# --accept-data-loss is passed, so it is safe to run on every boot.
CMD ["sh", "/app/scripts/db-push.sh"]
